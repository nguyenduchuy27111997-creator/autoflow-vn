# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Webhook URL for audit form submissions (n8n, Zapier, Make, etc.)
AUDIT_WEBHOOK_URL=https://your-n8n-instance.com/webhook/audit

# ─────────────────────────────────────────────────────────────────────
# Phase 120 — Trigger.dev email-queue durability
# ─────────────────────────────────────────────────────────────────────
# Feature flag for the durable email-queue path. Default: false (uses the
# existing Supabase-direct path). Flip to "true" per-route per D-03
# migration order: audit -> chat -> quiz -> tai-lieu -> newsletter -> partner.
# Local dev: leave as "false" — the SDK is dynamically imported only on
# the true branch (Pitfall 3 cold-start mitigation).
USE_TRIGGER_DEV=false

# Trigger.dev Cloud API secret key. Use tr_dev_* for staging/local; use
# tr_prod_* in Netlify production env. Capture from Trigger.dev Cloud
# dashboard -> Project -> API Keys. Do NOT commit a real key.
TRIGGER_SECRET_KEY=tr_dev_REPLACE_WITH_DASHBOARD_KEY

# ─────────────────────────────────────────────────────────────────────
# Phase 121 — PostHog Cloud EU funnel analytics
# ─────────────────────────────────────────────────────────────────────
# Project API key from https://eu.posthog.com -> Project Settings -> API Keys.
# This is the PUBLISHABLE key (phc_...) — safe to ship to the browser bundle.
# Leaving it unset disables PostHog entirely (instrumentation-client.ts
# guards posthog.init() behind this env var). That is the documented
# rollback path — removing the key fully disables tracking.
NEXT_PUBLIC_POSTHOG_KEY=phc_REPLACE_WITH_REAL_KEY_FROM_PASSWORD_MANAGER

# EU ingestion endpoint (NOT the dashboard URL eu.posthog.com). MANDATORY
# per CONTEXT.md D-05c — VN Law 91/2025 EU residency. Optional override:
# the instrumentation-client.ts default is the same value.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

